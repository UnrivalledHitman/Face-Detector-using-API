# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
FRONTEND_URL=http://localhost:5173

# ── Clarifai Face-Detection API ───────────────────────────────────────────────
# All four values are required for /imageurl to work.
# Create a free account at https://clarifai.com and generate a Personal Access Token (PAT).
CLARIFAI_PAT=your_personal_access_token_here
CLARIFAI_USER_ID=your_clarifai_user_id
CLARIFAI_APP_ID=your_clarifai_app_id
CLARIFAI_MODEL_ID=face-detection
CLARIFAI_MODEL_VERSION_ID=45fb9a671625463fa646c3523a3087d5

# ── Resend (password-reset email) ─────────────────────────────────────────────
# Required only for the forgot-password flow.
# Sign up at https://resend.com and add/verify your sending domain.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com